{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MarketDb": "Data Source=Data/market.db;Foreign Keys=True;Default Timeout=10;Pooling=True"
  },
  "MarketStorage": {
    "EnableDestructiveRetention": false,
    "SnapshotRetentionDays": 14,
    "FiveMinuteRetentionDays": 90,
    "HourlyRetentionDays": 730,
    "BatchRetentionDays": 30,
    "InsertBatchSize": 500,
    "DeleteBatchSize": 5000
  },
  "MarketCollector": {
    "Enabled": true,
    "IntervalMinutes": 5,
    "RunImmediately": true
  }
}
